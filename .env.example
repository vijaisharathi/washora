# ==========================================
# WASHORA Production Database Environment Configuration
# ==========================================

# PostgreSQL connection string with connection pooling
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/washora?schema=public&connection_limit=20&pool_timeout=30"

# Direct connection to PostgreSQL (used for Prisma migrations)
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/washora?schema=public"

# Application Environment
NODE_ENV="development"
PORT=4000

# Frontend Integration Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_VERSION="v1"
NEXT_PUBLIC_APP_ENV="development"
