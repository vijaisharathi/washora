# ==============================================================================
# WASHORA PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Authoritative Production Configuration Specification
# IMPORTANT: Never commit actual production secrets to source control.
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=4000
API_PREFIX=api
API_VERSION=v1

# PostgreSQL Production Database (Managed Instance with SSL & Connection Pool)
DATABASE_URL="postgresql://prod_user:SECURE_PASSWORD@prod-postgres.internal:5432/washora_prod?schema=public&sslmode=require&connection_limit=20&pool_timeout=30"
DIRECT_DATABASE_URL="postgresql://prod_user:SECURE_PASSWORD@prod-postgres.internal:5432/washora_prod?schema=public&sslmode=require"

# Production Authentication & JWT Hardening (Minimum 32 random characters)
JWT_ACCESS_SECRET="GENERATE_STRONG_RANDOM_64_CHAR_HEX_ACCESS_SECRET_FOR_PROD"
JWT_REFRESH_SECRET="GENERATE_STRONG_RANDOM_64_CHAR_HEX_REFRESH_SECRET_FOR_PROD"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Encryption & Data Protection (AES-256-GCM, 32 bytes minimum)
ENCRYPTION_KEY="GENERATE_SECURE_32_BYTE_ENCRYPTION_KEY_FOR_PROD_DATA"

# Strict Production CORS (Explicitly list all approved portal origins, no wildcards)
CORS_ORIGINS="https://app.washora.com,https://provider.washora.com,https://valet.washora.com,https://admin.washora.com"

# Logging & Observability
LOG_LEVEL=info

# Rate Limiting & Throttler (Standard: 100 req/min, Auth: 5 req/min)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Production Payment Gateway (Provider-neutral abstraction: stripe / razorpay)
PAYMENT_PROVIDER=stripe
PAYMENT_WEBHOOK_SECRET="whsec_GENERATE_PRODUCTION_WEBHOOK_SIGNING_SECRET"

# Production Communications (Email, SMS, Push Notification Adapters)
EMAIL_PROVIDER=ses
SMS_PROVIDER=twilio
PUSH_PROVIDER=fcm

# Cloud Object Storage (Private Bucket with Presigned URLs)
STORAGE_PROVIDER=s3
STORAGE_BUCKET="washora-production-assets"

# Maps & Geolocation Provider
MAPS_PROVIDER=google

# Webhook Base URL
WEBHOOK_BASE_URL="https://api.washora.com/api/v1/webhooks"

# Allow Mock Providers Override (Must remain false in production)
ALLOW_MOCK_PROVIDERS=false

# Swagger / OpenAPI Security
SWAGGER_ENABLED=false
SWAGGER_PROTECTED=true

# Frontend Integration Variables (Injected at Next.js build time)
NEXT_PUBLIC_API_BASE_URL="https://api.washora.com"
NEXT_PUBLIC_API_VERSION="v1"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_USE_LIVE_API="true"
