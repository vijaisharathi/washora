# ==============================================================================
# WASHORA STAGING ENVIRONMENT TEMPLATE (.env.staging.example)
# Production-like Staging Configuration for Pre-Launch Validation
# ==============================================================================

NODE_ENV=staging
PORT=4000
API_PREFIX=api
API_VERSION=v1

DATABASE_URL="postgresql://staging_user:STAGING_PASSWORD@staging-postgres.internal:5432/washora_staging?schema=public&sslmode=require&connection_limit=10&pool_timeout=30"
DIRECT_DATABASE_URL="postgresql://staging_user:STAGING_PASSWORD@staging-postgres.internal:5432/washora_staging?schema=public&sslmode=require"

JWT_ACCESS_SECRET="washora_staging_access_secret_hex_32_characters_min"
JWT_REFRESH_SECRET="washora_staging_refresh_secret_hex_32_characters_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

ENCRYPTION_KEY="washora_staging_encryption_key_32_bytes_length!"

CORS_ORIGINS="https://staging.washora.com,https://staging-admin.washora.com"
LOG_LEVEL=debug

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
THROTTLE_TTL=60
THROTTLE_LIMIT=200

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET="whsec_staging_test_secret_key"

EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
PUSH_PROVIDER=mock

STORAGE_PROVIDER=mock
STORAGE_BUCKET="washora-staging-assets"

MAPS_PROVIDER=mock
WEBHOOK_BASE_URL="https://staging-api.washora.com/api/v1/webhooks"
ALLOW_MOCK_PROVIDERS=true

SWAGGER_ENABLED=true
SWAGGER_PROTECTED=false

NEXT_PUBLIC_API_BASE_URL="https://staging-api.washora.com"
NEXT_PUBLIC_API_VERSION="v1"
NEXT_PUBLIC_APP_ENV="staging"
NEXT_PUBLIC_USE_LIVE_API="true"
