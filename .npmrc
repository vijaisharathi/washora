# ==============================================================================
# WASHORA Production npm Configuration & Supply Chain Hardening
# ==============================================================================

# Deterministic Lockfile Enforcement
package-lock=true
package-lock-only=false

# Vulnerability Audit Enabled on Install
audit=true
audit-level=high

# Registry Security & Scoped Protection (Anti-Dependency-Confusion)
registry=https://registry.npmjs.org/
@washora:registry=https://registry.npmjs.org/

# Suppress Marketing and Funding Noise in CI/Production
fund=false
update-notifier=false

# Strict Peer Dependencies
legacy-peer-deps=false

# Cache and Timeout Configurations
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
