// ============================================================================
// 1. IDENTITY & ACCESS DOMAIN
// ============================================================================

model User {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique @db.VarChar(254)
  passwordHash      String       @map("password_hash") @db.Text
  phone             String?      @db.VarChar(20)
  status            UserStatus   @default(ACTIVE)
  emailVerifiedAt   DateTime?    @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt   DateTime?    @map("phone_verified_at") @db.Timestamptz
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  sessions             Session[]
  organizationMembers  OrganizationMember[]
  customers            Customer[]
  providers            Provider[]
  deliveryPartners     DeliveryPartner[]
  statusHistories      BookingStatusHistory[]
  authoredNotes        BookingNote[]
  assignmentHistories  AssignmentHistory[]
  createdRefunds       Refund[]
  moderatedReviews     ReviewModerationHistory[]
  reportedReviews      ReviewReport[]            @relation("ReviewReporter")
  resolvedReviewReports ReviewReport[]           @relation("ReviewReportResolver")
  notifications        Notification[]
  notificationPref     NotificationPreference?
  sentCommunications   Communication[]
  communicationRecipients CommunicationRecipient[]
  assignedTickets      SupportTicket[]           @relation("AssignedTickets")
  createdTickets       SupportTicket[]           @relation("TicketCreator")
  sentSupportMessages  SupportMessage[]
  supportNotes         SupportNote[]
  supportActivities    SupportTicketActivity[]
  assignedDisputes     Dispute[]                 @relation("AssignedDisputes")
  createdDisputes      Dispute[]                 @relation("DisputeCreator")
  sentDisputeMessages  DisputeMessage[]
  submittedEvidence    DisputeEvidence[]
  disputeActivities    DisputeActivity[]
  auditEvents          AuditEvent[]
  analyticsEvents      AnalyticsEvent[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model OrganizationMember {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  roleId           String            @map("role_id") @db.Uuid
  fullName         String            @map("full_name") @db.VarChar(120)
  phone            String            @db.VarChar(20)
  profileImageUrl  String?           @map("profile_image_url") @db.Text
  primaryWorkArea  PrimaryWorkArea   @default(PLATFORM) @map("primary_work_area")
  preferredLanguage PreferredLanguage @default(ENGLISH) @map("preferred_language")
  timezone         String            @default("Asia/Kolkata") @db.VarChar(64)
  status           MemberStatus      @default(ACTIVE)
  joinedAt         DateTime          @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role              @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([roleId])
  @@map("organization_members")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  type        RoleType         @unique
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  members     OrganizationMember[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100) // e.g., "customer.read", "booking.update"
  module      String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// 2. ORGANIZATION (TENANT ROOT)
// ============================================================================

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  publicId    String             @unique @map("public_id") @db.VarChar(30) // e.g. "ORG-0001"
  name        String             @db.VarChar(150)
  email       String             @db.VarChar(254)
  phone       String             @db.VarChar(20)
  type        OrganizationType   @default(WASHORA)
  status      OrganizationStatus @default(ACTIVE)
  logoUrl     String?            @map("logo_url") @db.Text
  address     String?            @db.Text
  city        String?            @db.VarChar(80)
  state       String?            @db.VarChar(80)
  country     String             @default("IN") @db.VarChar(10)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Tenant Child Relations
  members              OrganizationMember[]
  customers            Customer[]
  customerAddresses    CustomerAddress[]
  customerFavorites    CustomerFavorite[]
  rewardAccounts       CustomerRewardAccount[]
  rewardTransactions   CustomerRewardTransaction[]
  providers            Provider[]
  providerServiceAreas ProviderServiceArea[]
  providerServices     ProviderService[]
  providerAvailability ProviderAvailability[]
  providerDocuments    ProviderDocument[]
  deliveryPartners     DeliveryPartner[]
  deliveryServiceAreas DeliveryServiceArea[]
  deliveryAvailability DeliveryAvailability[]
  deliveryDocuments    DeliveryDocument[]
  categories           ServiceCategory[]
  services             Service[]
  variants             ServiceVariant[]
  serviceImages        ServiceImage[]
  bookings             Booking[]
  bookingItems         BookingItem[]
  bookingAddresses     BookingAddress[]
  bookingSchedules     BookingSchedule[]
  pickupSlots          PickupSlot[]
  bookingStatusHist    BookingStatusHistory[]
  bookingNotes         BookingNote[]
  bookingAssignments   BookingAssignment[]
  assignmentHistories  AssignmentHistory[]
  deliveryEvents       DeliveryEvent[]
  payments             Payment[]
  transactions         Transaction[]
  earnings             Earning[]
  earningTransactions  EarningTransaction[]
  refunds              Refund[]
  coupons              Coupon[]
  couponRedemptions    CouponRedemption[]
  promotionalOffers    PromotionalOffer[]
  offerRedemptions     OfferRedemption[]
  reviews              Review[]
  reviewModerations    ReviewModerationHistory[]
  reviewResponses      ReviewResponse[]
  reviewReports        ReviewReport[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  notificationTemplates NotificationTemplate[]
  notificationEventLogs NotificationEventLog[]
  communications       Communication[]
  communicationRecips  CommunicationRecipient[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  supportNotes         SupportNote[]
  supportTicketActivities SupportTicketActivity[]
  disputes             Dispute[]
  disputeMessages      DisputeMessage[]
  disputeEvidence      DisputeEvidence[]
  disputeActivities    DisputeActivity[]
  auditEvents          AuditEvent[]
  analyticsEvents      AnalyticsEvent[]
  experiments          Experiment[]
  productImprovements  ProductImprovement[]

  @@index([status])
  @@map("organizations")
}

// ============================================================================
// 3. CUSTOMER DOMAIN
// ============================================================================

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  publicId        String         @map("public_id") @db.VarChar(30) // e.g. "CUS-0001"
  organizationId  String         @map("organization_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  fullName        String         @map("full_name") @db.VarChar(120)
  email           String         @db.VarChar(254)
  phone           String         @db.VarChar(20)
  profileImageUrl String?        @map("profile_image_url") @db.Text
  membershipTier  MembershipTier @default(STANDARD) @map("membership_tier")
  status          UserStatus     @default(ACTIVE)
  joinedAt        DateTime       @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses          CustomerAddress[]
  favorites          CustomerFavorite[]
  rewardAccount      CustomerRewardAccount?
  rewardTransactions CustomerRewardTransaction[]
  bookings           Booking[]
  couponRedemptions  CouponRedemption[]
  offerRedemptions   OfferRedemption[]
  reviews            Review[]
  supportTickets     SupportTicket[]
  disputes           Dispute[]

  @@unique([organizationId, publicId])
  @@unique([organizationId, userId])
  @@index([organizationId, fullName])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, status])
  @@map("customers")
}

model CustomerAddress {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  label          AddressLabel  @default(HOME)
  recipientName  String        @map("recipient_name") @db.VarChar(120)
  recipientPhone String        @map("recipient_phone") @db.VarChar(20)
  addressLine1   String        @map("address_line1") @db.VarChar(200)
  addressLine2   String?       @map("address_line2") @db.VarChar(200)
  area           String        @db.VarChar(100)
  city           String        @db.VarChar(80)
  state          String        @db.VarChar(80)
  postalCode     String        @map("postal_code") @db.VarChar(10)
  landmark       String?       @db.VarChar(150)
  latitude       Decimal?      @db.Decimal(10, 8)
  longitude      Decimal?      @db.Decimal(11, 8)
  isDefault      Boolean       @default(false) @map("is_default")
  status         AddressStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
  @@index([organizationId, city])
  @@map("customer_addresses")
}

model CustomerFavorite {
  id             String       @id @default(uuid()) @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  serviceId      String       @map("service_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceId])
  @@index([organizationId, customerId])
  @@map("customer_favorites")
}

model CustomerRewardAccount {
  id               String       @id @default(uuid()) @db.Uuid
  customerId       String       @unique @map("customer_id") @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  pointsBalance    Int          @default(0) @map("points_balance")
  lifetimeEarned   Int          @default(0) @map("lifetime_earned")
  lifetimeRedeemed Int          @default(0) @map("lifetime_redeemed")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions     CustomerRewardTransaction[]

  @@index([organizationId, customerId])
  @@map("customer_reward_accounts")
}

model CustomerRewardTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  rewardAccountId String                @map("reward_account_id") @db.Uuid
  customerId      String                @map("customer_id") @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  bookingId       String?               @map("booking_id") @db.Uuid
  type            RewardTransactionType
  points          Int
  balanceAfter    Int                   @map("balance_after")
  description     String                @db.VarChar(300)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  rewardAccount   CustomerRewardAccount @relation(fields: [rewardAccountId], references: [id], onDelete: Cascade)
  customer        Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking         Booking?              @relation(fields: [bookingId], references: [id])

  @@index([rewardAccountId, createdAt])
  @@index([organizationId, customerId])
  @@map("customer_reward_transactions")
}

// ============================================================================
// 4. PROVIDER DOMAIN
// ============================================================================

model Provider {
  id                String                 @id @default(uuid()) @db.Uuid
  publicId          String                 @map("public_id") @db.VarChar(30) // e.g. "PRO-0001"
  organizationId    String                 @map("organization_id") @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  businessName      String?                @map("business_name") @db.VarChar(150)
  fullName          String                 @map("full_name") @db.VarChar(120)
  email             String                 @db.VarChar(254)
  phone             String                 @db.VarChar(20)
  profileImageUrl   String?                @map("profile_image_url") @db.Text
  coverImageUrl     String?                @map("cover_image_url") @db.Text
  description       String?                @db.Text
  city              String                 @db.VarChar(80)
  address           String?                @db.Text
  status            ProviderStatus         @default(INACTIVE)
  approvalStatus    ProviderApprovalStatus @default(PENDING) @map("approval_status")
  rating            Decimal                @default(0.00) @db.Decimal(3, 2)
  totalReviews      Int                    @default(0) @map("total_reviews")
  totalBookings     Int                    @default(0) @map("total_bookings")
  completedBookings Int                    @default(0) @map("completed_bookings")
  cancelledBookings Int                    @default(0) @map("cancelled_bookings")
  totalEarnings     Decimal                @default(0.00) @map("total_earnings") @db.Decimal(12, 2)
  lastActiveAt      DateTime?              @map("last_active_at") @db.Timestamptz
  joinedAt          DateTime               @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
