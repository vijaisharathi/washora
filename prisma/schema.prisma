model SupportTicket {
  id               String               @id @default(uuid()) @db.Uuid
  publicId         String               @map("public_id") @db.VarChar(30) // e.g. "SUP-2026-000001"
  organizationId   String               @map("organization_id") @db.Uuid
  createdByUserId  String?              @map("created_by_user_id") @db.Uuid
  requesterType    SupportRequesterType @map("requester_type")
  customerId       String?              @map("customer_id") @db.Uuid
  providerId       String?              @map("provider_id") @db.Uuid
  deliveryPartnerId String?             @map("delivery_partner_id") @db.Uuid
  bookingId        String?              @map("booking_id") @db.Uuid
  paymentId        String?              @map("payment_id") @db.Uuid
  category         SupportCategory
  priority         SupportPriority      @default(MEDIUM)
  status           SupportStatus        @default(OPEN)
  subject          String               @db.VarChar(200)
  description      String               @db.Text
  assignedToUserId String?              @map("assigned_to_user_id") @db.Uuid
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz
  resolutionNote   String?              @map("resolution_note") @db.Text
  closedAt         DateTime?            @map("closed_at") @db.Timestamptz
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser    User?                @relation("TicketCreator", fields: [createdByUserId], references: [id])
  customer         Customer?            @relation(fields: [customerId], references: [id])
  provider         Provider?            @relation(fields: [providerId], references: [id])
  deliveryPartner  DeliveryPartner?     @relation(fields: [deliveryPartnerId], references: [id])
  booking          Booking?             @relation(fields: [bookingId], references: [id])
  payment          Payment?             @relation(fields: [paymentId], references: [id])
  assignedToUser   User?                @relation("AssignedTickets", fields: [assignedToUserId], references: [id])
  notes            SupportNote[]
  messages         SupportMessage[]
  activities       SupportTicketActivity[]
  disputes         Dispute[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status, priority])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, customerId])
  @@index([organizationId, providerId])
  @@index([organizationId, deliveryPartnerId])
  @@index([organizationId, bookingId])
  @@index([organizationId, paymentId])
  @@index([organizationId, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id             String        @id @default(uuid()) @db.Uuid
  publicId       String        @map("public_id") @db.VarChar(30) // e.g. "MSG-2026-000001"
  organizationId String        @map("organization_id") @db.Uuid
  ticketId       String        @map("ticket_id") @db.Uuid
  senderUserId   String        @map("sender_user_id") @db.Uuid
  message        String        @db.Text
  isInternal     Boolean       @default(false) @map("is_internal")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderUser     User          @relation(fields: [senderUserId], references: [id])

  @@unique([organizationId, publicId])
  @@index([ticketId, createdAt])
  @@index([organizationId, ticketId])
  @@index([organizationId, senderUserId])
  @@map("support_messages")
}

model SupportNote {
  id             String        @id @default(uuid()) @db.Uuid
  publicId       String?       @map("public_id") @db.VarChar(30)
  ticketId       String        @map("ticket_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  authorUserId   String        @map("author_user_id") @db.Uuid
  message        String        @db.Text
  isInternalOnly Boolean       @default(true) @map("is_internal_only")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorUser     User          @relation(fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([organizationId, ticketId])
  @@map("support_notes")
}

model SupportTicketActivity {
  id             String        @id @default(uuid()) @db.Uuid
  ticketId       String        @map("ticket_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(100)
  previousValue  String?       @map("previous_value") @db.Text
  newValue       String?       @map("new_value") @db.Text
  metadata       Json?         @map("metadata")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?         @relation(fields: [actorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([organizationId, ticketId])
  @@map("support_ticket_activities")
}

model Dispute {
  id                String                 @id @default(uuid()) @db.Uuid
  publicId          String                 @map("public_id") @db.VarChar(30) // e.g. "DSP-0001"
  organizationId    String                 @map("organization_id") @db.Uuid
  ticketId          String?                @map("ticket_id") @db.Uuid
  bookingId         String                 @map("booking_id") @db.Uuid
  paymentId         String?                @map("payment_id") @db.Uuid
  createdByUserId   String?                @map("created_by_user_id") @db.Uuid
  raisedByType      DisputeParticipantType @map("raised_by_type")
  customerId        String?                @map("customer_id") @db.Uuid
  providerId        String?                @map("provider_id") @db.Uuid
  deliveryPartnerId String?                @map("delivery_partner_id") @db.Uuid
  type              DisputeType
  priority          SupportPriority        @default(HIGH)
  status            DisputeStatus          @default(OPEN)
  claimAmount       Decimal?               @map("claim_amount") @db.Decimal(12, 2)
  resolvedAmount    Decimal?               @map("resolved_amount") @db.Decimal(12, 2)
  currency          String                 @default("INR") @db.VarChar(10)
  outcome           DisputeOutcome?
  resolutionType    String?                @map("resolution_type") @db.VarChar(50)
  resolutionNote    String?                @map("resolution_note") @db.Text
  reason            String                 @db.VarChar(255)
  description       String                 @db.Text
  assignedToUserId  String?                @map("assigned_to_user_id") @db.Uuid
  decisionReason    String?                @map("decision_reason") @db.Text
  resolvedAt        DateTime?              @map("resolved_at") @db.Timestamptz
  closedAt          DateTime?              @map("closed_at") @db.Timestamptz
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket            SupportTicket?         @relation(fields: [ticketId], references: [id])
  booking           Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment           Payment?               @relation(fields: [paymentId], references: [id])
  createdByUser     User?                  @relation("DisputeCreator", fields: [createdByUserId], references: [id])
  customer          Customer?              @relation(fields: [customerId], references: [id])
  provider          Provider?              @relation(fields: [providerId], references: [id])
  deliveryPartner   DeliveryPartner?       @relation(fields: [deliveryPartnerId], references: [id])
  assignedToUser    User?                  @relation("AssignedDisputes", fields: [assignedToUserId], references: [id])
  evidence          DisputeEvidence[]
  activities        DisputeActivity[]
  messages          DisputeMessage[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status, priority])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, bookingId])
  @@index([organizationId, ticketId])
  @@index([organizationId, customerId])
  @@index([organizationId, providerId])
  @@index([organizationId, deliveryPartnerId])
  @@map("disputes")
}

model DisputeMessage {
  id             String        @id @default(uuid()) @db.Uuid
  publicId       String        @map("public_id") @db.VarChar(30)
  organizationId String        @map("organization_id") @db.Uuid
  disputeId      String        @map("dispute_id") @db.Uuid
  senderUserId   String        @map("sender_user_id") @db.Uuid
  message        String        @db.Text
  isInternal     Boolean       @default(false) @map("is_internal")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  dispute        Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderUser     User          @relation(fields: [senderUserId], references: [id])

  @@unique([organizationId, publicId])
  @@index([disputeId, createdAt])
  @@index([organizationId, disputeId])
  @@index([organizationId, senderUserId])
  @@map("dispute_messages")
}

model DisputeEvidence {
  id                String       @id @default(uuid()) @db.Uuid
  publicId          String?      @map("public_id") @db.VarChar(30)
  disputeId         String       @map("dispute_id") @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  submittedByUserId String?      @map("submitted_by_user_id") @db.Uuid
  title             String       @db.VarChar(150)
  description       String?      @db.Text
  fileUrl           String       @map("file_url") @db.Text
  fileType          String       @map("file_type") @db.VarChar(50) // "PHOTO", "VIDEO", "DOCUMENT", "RECEIPT", "SCREENSHOT", "OTHER"
  storageKey        String?      @map("storage_key") @db.VarChar(255)
  mimeType          String?      @map("mime_type") @db.VarChar(100)
  fileName          String?      @map("file_name") @db.VarChar(255)
  fileSize          Int?         @map("file_size")
  uploadedByType    String       @map("uploaded_by_type") @db.VarChar(30)
  status            String       @default("SUBMITTED") @db.VarChar(30)
  rejectionReason   String?      @map("rejection_reason") @db.Text
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  dispute           Dispute      @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedByUser   User?        @relation(fields: [submittedByUserId], references: [id])

  @@index([disputeId])
  @@index([organizationId, disputeId])
  @@map("dispute_evidence")
}

model DisputeActivity {
  id             String        @id @default(uuid()) @db.Uuid
  disputeId      String        @map("dispute_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(100)
  previousValue  String?       @map("previous_value") @db.Text
  newValue       String?       @map("new_value") @db.Text
  details        String?       @db.Text
  metadata       Json?         @map("metadata")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  dispute        Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?         @relation(fields: [actorUserId], references: [id])

  @@index([disputeId, createdAt])
  @@index([organizationId, disputeId])
  @@map("dispute_activities")
}

