// ============================================================================
// WASHORA Production Database Schema
// Authoritative Source of Truth: WASHORA_Complete_Production_Database_Schema_PRD.docx
// Architecture: Multi-tenant relational marketplace on PostgreSQL with Prisma ORM
// ============================================================================

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

