  // Relations
  booking           Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          Provider?        @relation(fields: [providerId], references: [id])
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  history           AssignmentHistory[]
  deliveryEvents    DeliveryEvent[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status])
  @@index([organizationId, bookingId])
  @@index([organizationId, providerId])
  @@index([organizationId, deliveryPartnerId])
  @@map("booking_assignments")
}

model AssignmentHistory {
  id             String            @id @default(uuid()) @db.Uuid
  assignmentId   String            @map("assignment_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  action         AssignmentAction
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  details        String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  assignment     BookingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?             @relation(fields: [actorUserId], references: [id])

  @@index([assignmentId, createdAt])
  @@index([organizationId, assignmentId])
  @@map("assignment_history")
}

model DeliveryEvent {
  id                String            @id @default(uuid()) @db.Uuid
  bookingId         String            @map("booking_id") @db.Uuid
  assignmentId      String?           @map("assignment_id") @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  deliveryPartnerId String?           @map("delivery_partner_id") @db.Uuid
  eventType         String            @map("event_type") @db.VarChar(60) // "ARRIVED_AT_PICKUP", "OTP_VERIFIED", "HANDED_TO_STUDIO", "DELIVERED"
  latitude          Decimal?          @db.Decimal(10, 8)
  longitude         Decimal?          @db.Decimal(11, 8)
  proofImageUrl     String?           @map("proof_image_url") @db.Text
  notes             String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignment        BookingAssignment? @relation(fields: [assignmentId], references: [id])
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner?  @relation(fields: [deliveryPartnerId], references: [id])

  @@index([bookingId, createdAt])
  @@index([organizationId, bookingId])
  @@map("delivery_events")
}

// ============================================================================
// 9. FINANCE DOMAIN
// ============================================================================

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  publicId       String        @map("public_id") @db.VarChar(30) // e.g. "PAY-0001"
  bookingId      String        @unique @map("booking_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR") @db.VarChar(5)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  gatewayRef     String?       @map("gateway_ref") @db.VarChar(120)
  gatewayName    String?       @map("gateway_name") @db.VarChar(50)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  failureReason  String?       @map("failure_reason") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  refunds        Refund[]
  supportTickets SupportTicket[]
  disputes       Dispute[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status])
  @@index([organizationId, bookingId])
  @@index([organizationId, createdAt])
  @@map("payments")
}

model Transaction {
  id                 String             @id @default(uuid()) @db.Uuid
  publicId           String             @map("public_id") @db.VarChar(30) // e.g. "TXN-0001"
  organizationId     String             @map("organization_id") @db.Uuid
  bookingId          String?            @map("booking_id") @db.Uuid
  paymentId          String?            @map("payment_id") @db.Uuid
  type               TransactionType
  amount             Decimal            @db.Decimal(12, 2)
  currency           String             @default("INR") @db.VarChar(5)
  status             TransactionStatus  @default(COMPLETED)
  referenceNumber    String?            @map("reference_number") @db.VarChar(100)
  description        String             @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking            Booking?           @relation(fields: [bookingId], references: [id])
  payment            Payment?           @relation(fields: [paymentId], references: [id])
  earningTransactions EarningTransaction[]
  refunds            Refund[]

  @@unique([organizationId, publicId])
  @@index([organizationId, type, status])
  @@index([organizationId, bookingId])
  @@index([organizationId, createdAt])
  @@map("transactions")
}

model Earning {
  id                String             @id @default(uuid()) @db.Uuid
  publicId          String             @map("public_id") @db.VarChar(30) // e.g. "ERN-0001"
  organizationId    String             @map("organization_id") @db.Uuid
  bookingId         String             @map("booking_id") @db.Uuid
  providerId        String?            @map("provider_id") @db.Uuid
  deliveryPartnerId String?            @map("delivery_partner_id") @db.Uuid
  grossAmount       Decimal            @map("gross_amount") @db.Decimal(12, 2)
  platformFee       Decimal            @default(0.00) @map("platform_fee") @db.Decimal(12, 2)
  taxWithheld       Decimal            @default(0.00) @map("tax_withheld") @db.Decimal(12, 2)
  netAmount         Decimal            @map("net_amount") @db.Decimal(12, 2)
  currency          String             @default("INR") @db.VarChar(5)
  status            EarningStatus      @default(PENDING)
  payoutDate        DateTime?          @map("payout_date") @db.Timestamptz
  payoutRef         String?            @map("payout_ref") @db.VarChar(100)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider          Provider?          @relation(fields: [providerId], references: [id])
  deliveryPartner   DeliveryPartner?   @relation(fields: [deliveryPartnerId], references: [id])
  transactions      EarningTransaction[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status])
  @@index([organizationId, providerId])
  @@index([organizationId, deliveryPartnerId])
  @@index([organizationId, createdAt])
  @@map("earnings")
}

model EarningTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  earningId      String                @map("earning_id") @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  transactionId  String?               @map("transaction_id") @db.Uuid
  type           EarningTransactionType
  amount         Decimal               @db.Decimal(12, 2)
  currency       String                @default("INR") @db.VarChar(5)
  notes          String?               @db.VarChar(255)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  earning        Earning               @relation(fields: [earningId], references: [id], onDelete: Cascade)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction    Transaction?          @relation(fields: [transactionId], references: [id])

  @@index([earningId])
  @@index([organizationId, earningId])
  @@map("earning_transactions")
}

model Refund {
  id              String        @id @default(uuid()) @db.Uuid
  publicId        String        @map("public_id") @db.VarChar(30) // e.g. "REF-0001"
  bookingId       String        @map("booking_id") @db.Uuid
  paymentId       String        @map("payment_id") @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  transactionId   String?       @map("transaction_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR") @db.VarChar(5)
  status          RefundStatus  @default(PENDING)
  reason          String        @db.VarChar(255)
  gatewayRefundRef String?      @map("gateway_refund_ref") @db.VarChar(120)
  processedByUserId String?     @map("processed_by_user_id") @db.Uuid
  processedAt     DateTime?     @map("processed_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction     Transaction?  @relation(fields: [transactionId], references: [id])
  processedByUser User?         @relation(fields: [processedByUserId], references: [id])

  @@unique([organizationId, publicId])
  @@index([organizationId, status])
  @@index([organizationId, bookingId])
  @@index([organizationId, createdAt])
  @@map("refunds")
}

