model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  publicId        String               @map("public_id") @db.VarChar(30) // e.g. "NOT-0001"
  organizationId  String               @map("organization_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  type            NotificationType
  title           String               @db.VarChar(150)
  message         String               @db.Text
  priority        NotificationPriority @default(MEDIUM)
  status          NotificationStatus   @default(UNREAD)
  linkUrl         String?              @map("link_url") @db.Text
  data            Json?                @map("data")
  readAt          DateTime?            @map("read_at") @db.Timestamptz
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientUser   User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  communications  Communication[]

  @@unique([organizationId, publicId])
  @@index([organizationId, recipientUserId, status])
  @@index([organizationId, createdAt])
