  @@index([organizationId, eventName, createdAt])
  @@index([organizationId, eventCategory, createdAt])
  @@index([organizationId, actorUserId])
  @@map("analytics_events")
}

model Experiment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  key            String        @unique @db.VarChar(100)
  name           String        @db.VarChar(150)
  hypothesis     String        @db.Text
  status         String        @default("DRAFT") @db.VarChar(30)
  targetAudience String        @default("ALL") @map("target_audience") @db.VarChar(50)
  primaryMetric  String        @map("primary_metric") @db.VarChar(100)
  startDate      DateTime?     @map("start_date") @db.Timestamptz
  endDate        DateTime?     @map("end_date") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants       ExperimentVariant[]
  assignments    ExperimentAssignment[]

  @@index([organizationId, status])
  @@map("experiments")
}

model ExperimentVariant {
  id                String        @id @default(uuid()) @db.Uuid
  experimentId      String        @map("experiment_id") @db.Uuid
  key               String        @db.VarChar(50)
  name              String        @db.VarChar(100)
  trafficAllocation Int           @default(50) @map("traffic_allocation")
  payloadJson       Json?         @map("payload_json")

  experiment        Experiment    @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignments       ExperimentAssignment[]

  @@unique([experimentId, key])
  @@map("experiment_variants")
}

model ExperimentAssignment {
  id             String            @id @default(uuid()) @db.Uuid
  experimentId   String            @map("experiment_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  anonymousId    String?           @map("anonymous_id") @db.VarChar(100)
  assignedAt     DateTime          @default(now()) @map("assigned_at") @db.Timestamptz
  hasExposed     Boolean           @default(false) @map("has_exposed")
  hasConverted   Boolean           @default(false) @map("has_converted")

  experiment     Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant        ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([experimentId, actorUserId])
  @@index([experimentId, anonymousId])
  @@map("experiment_assignments")
}

model ProductImprovement {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  title               String        @db.VarChar(200)
  problem             String        @db.Text
  evidence            String        @db.Text
  hypothesis          String        @db.Text
  proposedChange      String        @map("proposed_change") @db.Text
  expectedImpact      String        @map("expected_impact") @db.VarChar(100)
  priority            String        @default("MEDIUM") @db.VarChar(20)
  status              String        @default("IDEA") @db.VarChar(30)
  owner               String        @db.VarChar(100)
  linkedKpi           String?       @map("linked_kpi") @db.VarChar(100)
  linkedExperimentKey String?       @map("linked_experiment_key") @db.VarChar(100)
  decision            String?       @db.Text
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("product_improvements")
}

