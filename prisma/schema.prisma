model AnalyticsEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actorRole      String        @map("actor_role") @db.VarChar(50)
  sessionId      String?       @map("session_id") @db.VarChar(100)
  eventName      String        @map("event_name") @db.VarChar(100)
  eventCategory  String        @map("event_category") @db.VarChar(50)
  requestId      String?       @map("request_id") @db.VarChar(100)
  source         String        @default("web") @db.VarChar(50)
  platform       String?       @db.VarChar(50)
  entityType     String?       @map("entity_type") @db.VarChar(60)
  entityId       String?       @map("entity_id") @db.VarChar(60)
  properties     Json?         @map("properties")
  schemaVersion  String        @default("1.0.0") @map("schema_version") @db.VarChar(20)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
