model Review {
  id               String         @id @default(uuid()) @db.Uuid
  publicId         String         @map("public_id") @db.VarChar(30) // e.g. "REV-0001"
  bookingId        String         @unique @map("booking_id") @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  providerId       String         @map("provider_id") @db.Uuid
  serviceId        String         @map("service_id") @db.Uuid
  rating           Int            // 1–5
  title            String?        @db.VarChar(120)
  comment          String?        @db.Text
  response         String?        @db.Text
  responseAt       DateTime?      @map("response_at") @db.Timestamptz
  status           ReviewStatus   @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  publishedAt      DateTime?      @map("published_at") @db.Timestamptz
  moderatedAt      DateTime?      @map("moderated_at") @db.Timestamptz
  moderatedBy      String?        @map("moderated_by") @db.Uuid
  moderationReason String?        @map("moderation_reason") @db.Text

  // Relations
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id])
  provider         Provider       @relation(fields: [providerId], references: [id])
  service          Service        @relation(fields: [serviceId], references: [id])
  moderationHist   ReviewModerationHistory[]
  reviewResponse   ReviewResponse?
  reports          ReviewReport[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status])
  @@index([organizationId, providerId])
  @@index([organizationId, serviceId])
  @@map("reviews")
}

model ReviewModerationHistory {
  id              String                 @id @default(uuid()) @db.Uuid
  reviewId        String                 @map("review_id") @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  moderatorUserId String                 @map("moderator_user_id") @db.Uuid
  actorUserId     String?                @map("actor_user_id") @db.Uuid
  fromStatus      ReviewStatus           @map("from_status")
  toStatus        ReviewStatus           @map("to_status")
  action          ReviewModerationAction @default(PUBLISHED)
  reason          ReviewModerationReason
  notes           String?                @db.Text
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  review          Review                 @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moderatorUser   User                   @relation(fields: [moderatorUserId], references: [id])

  @@index([reviewId, createdAt])
  @@index([organizationId, reviewId])
  @@map("review_moderation_history")
}

model ReviewResponse {
  id             String       @id @default(uuid()) @db.Uuid
  reviewId       String       @unique @map("review_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  providerId     String       @map("provider_id") @db.Uuid
  comment        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  review         Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([organizationId, providerId])
  @@map("review_responses")
}

model ReviewReport {
  id               String             @id @default(uuid()) @db.Uuid
  publicId         String             @map("public_id") @db.VarChar(30) // e.g. "RPT-0001"
  organizationId   String             @map("organization_id") @db.Uuid
  reviewId         String             @map("review_id") @db.Uuid
  reportedByUserId String             @map("reported_by_user_id") @db.Uuid
  reason           ReviewReportReason
  description      String?            @db.Text
  status           ReviewReportStatus @default(OPEN)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt       DateTime?          @map("resolved_at") @db.Timestamptz
  resolvedByUserId String?            @map("resolved_by_user_id") @db.Uuid
  resolutionNote   String?            @map("resolution_note") @db.Text

  // Relations
  review           Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedByUser   User               @relation("ReviewReporter", fields: [reportedByUserId], references: [id])
  resolvedByUser   User?              @relation("ReviewReportResolver", fields: [resolvedByUserId], references: [id])

  @@unique([reviewId, reportedByUserId])
  @@unique([organizationId, publicId])
  @@index([organizationId, status])
  @@index([organizationId, reviewId])
  @@map("review_reports")
}

