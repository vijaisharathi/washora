model Coupon {
  id             String        @id @default(uuid()) @db.Uuid
  publicId       String        @map("public_id") @db.VarChar(30) // e.g. "CPN-0001"
  organizationId String        @map("organization_id") @db.Uuid
  code           String        @db.VarChar(30)
  title          String        @db.VarChar(120)
  description    String?       @db.Text
  discountType   DiscountType  @map("discount_type")
  discountValue  Decimal       @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount Decimal       @default(0.00) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?      @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int?          @map("usage_limit")
  usedCount      Int           @default(0) @map("used_count")
  validFrom      DateTime      @map("valid_from") @db.Timestamptz
  validUntil     DateTime      @map("valid_until") @db.Timestamptz
  status         CouponStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions    CouponRedemption[]

  @@unique([organizationId, publicId])
  @@unique([organizationId, code])
  @@index([organizationId, status, validUntil])
  @@map("coupons")
}

model CouponRedemption {
  id             String       @id @default(uuid()) @db.Uuid
  couponId       String       @map("coupon_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  bookingId      String       @map("booking_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  discountApplied Decimal     @map("discount_applied") @db.Decimal(12, 2)
  redeemedAt     DateTime     @default(now()) @map("redeemed_at") @db.Timestamptz

  // Relations
  coupon         Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id])
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerId])
  @@index([organizationId, customerId])
  @@map("coupon_redemptions")
}

model PromotionalOffer {
  id             String       @id @default(uuid()) @db.Uuid
  publicId       String       @map("public_id") @db.VarChar(30) // e.g. "OFF-0001"
  organizationId String       @map("organization_id") @db.Uuid
  title          String       @db.VarChar(150)
  bannerText     String?      @map("banner_text") @db.VarChar(255)
  bannerImageUrl String?      @map("banner_image_url") @db.Text
  discountType   DiscountType @map("discount_type")
  discountValue  Decimal      @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount Decimal      @default(0.00) @map("min_order_amount") @db.Decimal(12, 2)
  validFrom      DateTime     @map("valid_from") @db.Timestamptz
  validUntil     DateTime     @map("valid_until") @db.Timestamptz
  status         OfferStatus  @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions    OfferRedemption[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status, validUntil])
  @@map("promotional_offers")
}

model OfferRedemption {
  id             String           @id @default(uuid()) @db.Uuid
  offerId        String           @map("offer_id") @db.Uuid
  customerId     String           @map("customer_id") @db.Uuid
  bookingId      String           @map("booking_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  discountApplied Decimal         @map("discount_applied") @db.Decimal(12, 2)
  redeemedAt     DateTime         @default(now()) @map("redeemed_at") @db.Timestamptz

  // Relations
  offer          PromotionalOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id])
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([customerId])
  @@index([organizationId, customerId])
  @@map("offer_redemptions")
}

// ============================================================================
// 11. REVIEWS DOMAIN
