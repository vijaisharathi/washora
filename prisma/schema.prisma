model NotificationTemplate {
  id             String               @id @default(uuid()) @db.Uuid
  publicId       String               @map("public_id") @db.VarChar(30) // e.g. "TMP-2026-000001"
  organizationId String               @map("organization_id") @db.Uuid
  type           String               @db.VarChar(80) // e.g. "ORDER_STATUS", "BOOKING_CONFIRMED"
  channel        CommunicationChannel @default(IN_APP)
  subject        String?              @db.VarChar(200)
  titleTemplate  String               @map("title_template") @db.VarChar(200)
  bodyTemplate   String               @map("body_template") @db.Text
  version        Int                  @default(1)
  status         String               @default("ACTIVE") @db.VarChar(30) // "ACTIVE", "ARCHIVED"
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, publicId])
  @@unique([organizationId, type, channel, version])
  @@index([organizationId, type, channel, status])
  @@map("notification_templates")
}

model Communication {
  id                String               @id @default(uuid()) @db.Uuid
  publicId          String               @map("public_id") @db.VarChar(30) // e.g. "COM-0001"
  organizationId    String               @map("organization_id") @db.Uuid
  senderUserId      String               @map("sender_user_id") @db.Uuid
  notificationId    String?              @map("notification_id") @db.Uuid
  type              String               @default("TRANSACTIONAL") @db.VarChar(40)
  channel           CommunicationChannel @default(IN_APP)
  subject           String               @db.VarChar(200)
  body              String               @db.Text
  content           String?              @map("content") @db.Text
  status            CommunicationStatus  @default(SENT)
  provider          String?              @default("MOCK") @db.VarChar(60)
  providerMessageId String?              @map("provider_message_id") @db.VarChar(100)
  attemptCount      Int                  @default(1) @map("attempt_count")
  lastAttemptAt     DateTime?            @map("last_attempt_at") @db.Timestamptz
  failedAt          DateTime?            @map("failed_at") @db.Timestamptz
  failureReason     String?              @map("failure_reason") @db.Text
  sentAt            DateTime?            @map("sent_at") @db.Timestamptz
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderUser        User                 @relation(fields: [senderUserId], references: [id])
  notification      Notification?        @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  recipients        CommunicationRecipient[]

  @@unique([organizationId, publicId])
  @@index([organizationId, status])
  @@index([organizationId, notificationId])
  @@index([organizationId, createdAt])
  @@map("communications")
}

model CommunicationRecipient {
  id              String               @id @default(uuid()) @db.Uuid
  communicationId String               @map("communication_id") @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  recipientType   RecipientType        @map("recipient_type")
  recipientId     String?              @map("recipient_id") @db.Uuid
  userId          String?              @map("user_id") @db.Uuid
  channelAddress  String?              @map("channel_address") @db.VarChar(150)
  status          CommunicationStatus  @default(SENT) @map("status")
  isRead          Boolean              @default(false) @map("is_read")
  readAt          DateTime?            @map("read_at") @db.Timestamptz
  deliveredAt     DateTime?            @map("delivered_at") @db.Timestamptz
  failedAt        DateTime?            @map("failed_at") @db.Timestamptz
  failureReason   String?              @map("failure_reason") @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  communication   Communication        @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([communicationId])
  @@index([organizationId, recipientId])
  @@index([organizationId, userId])
  @@map("communication_recipients")
}

model NotificationEventLog {
  id             String       @id @default(uuid()) @db.Uuid
  eventId        String       @unique @map("event_id") @db.VarChar(100) // SHA-256 or UUID
  organizationId String       @map("organization_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(80)
  resourceType   String       @map("resource_type") @db.VarChar(60)
  resourceId     String       @map("resource_id") @db.VarChar(60)
  payload        Json         @map("payload")
  processedAt    DateTime     @default(now()) @map("processed_at") @db.Timestamptz

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventType])
  @@index([organizationId, resourceType, resourceId])
  @@map("notification_event_logs")
}

// ============================================================================
// 13. SUPPORT & DISPUTES DOMAIN
